# Copy to .env and fill in. Never commit .env.
# Data is kept in memory and reset to the seed on every restart (no database needed).
API_PORT=3000


# Secret used to sign login sessions (JWT). Generate your own:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Days a customer may raise a claim, from the order's completed date
# (or the order date while it is only shipped). 0 = no deadline.
CLAIM_WINDOW_DAYS=90

# Optional external stock APIs, one per partner store. Leave blank to sell
# only the store's own catalogue. Format: key|Display Name|URL, comma separated
PARTNER_APIS=

# Optional. Blank = app runs without AI; /api/ai/* answers 503 AI_NOT_CONFIGURED.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
